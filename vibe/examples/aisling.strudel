// AISLING (VIBE FM 1.3) as an instrument in strdltn Live[code].
// The piece plays itself; these lines add a bass on the Sequence and a tune on the Lead.
// Skellig is in D minor (aeolian) at 76. AISLING follows a tempo from 60 to 160.

firmware('https://github.com/stephencummins/vibe-aisling/releases/latest/download/aisling.zip')

setcps(76 / 240)

// channel 3: the Sequence (the harp), plucked, by its velocity
$bass: note("<d2 d2 bb1 c2>*2").s("vibefm1:aisling").midichan(3).velocity(0.8)

// channel 2: the Lead (the flute), the notes as written
$tune: note("<[d4 f4 a4 g4] [f4 e4 d4 ~] [a4 c5 a4 g4] [f4 ~ d4 ~]>").s("vibefm1:aisling").midichan(2)

// another piece: .progNum(0) to .progNum(7) on any line, for example
// $tune: note("a4").s("vibefm1:aisling").midichan(2).progNum(2)   // Aran
